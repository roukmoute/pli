{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "plugins": [
    {
      "path": "./lint/no-class-inheritance.grit",
      "includes": ["**/*.{ts,tsx,mts,cts}"]
    }
  ],
  "files": {
    "includes": [
      "**",
      "!!**/dist",
      "!!**/node_modules",
      "!**/package-lock.json"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true
  }
}
